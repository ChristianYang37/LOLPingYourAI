{
  "name": "lolpingyourai",
  "productName": "LOLPingYourAI",
  "version": "0.1.4",
  "private": true,
  "description": "Ping your AI teammate anywhere on your desktop",
  "author": "LOLPingYourAI contributors",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test ai/test/*.test.mjs",
    "build:helper": "node native/hook-helper/run.mjs build",
    "test:helper": "node native/hook-helper/run.mjs test",
    "dist": "npm run build:helper && npm run build:desktop && electron-vite build && electron-builder --win --publish never",
    "dist:mac": "npm run build:helper && npm run build:desktop && electron-vite build && electron-builder --mac --arm64 --publish never",
    "test:ai": "node --test ai/test/*.test.mjs",
    "test:acceptance": "node --test tools/acceptance/test/*.test.mjs",
    "acceptance": "node tools/acceptance/run.mjs",
    "build:desktop": "node native/desktop/build.mjs",
    "test:windows": "node tools/windows/check-native.mjs",
    "test:packaged": "node tools/windows/check-app.mjs",
    "test:performance": "electron tools/diagnostics/performance.cjs"
  },
  "devDependencies": {
    "@fluentui/react-components": "9.74.9",
    "@fluentui/react-icons": "2.0.343",
    "@noble/secp256k1": "3.2.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.10",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "katex": "^0.16.47",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  },
  "build": {
    "appId": "dev.lolpingyourai.desktop",
    "productName": "LOLPingYourAI",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "ai/**/*",
      "skills/**/*",
      "!ai/test/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "native/hook-helper/build/hook-helper.exe",
          "to": "hook-helper.exe"
        },
        {
          "from": "native/desktop/build/desktop-helper.exe",
          "to": "desktop-helper.exe"
        },
        {
          "from": "build/icon.png",
          "to": "icon.png"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "LOLPingYourAI-Setup-${version}.exe",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "13.0",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "native/hook-helper/build/hook-helper",
          "to": "hook-helper"
        },
        {
          "from": "build",
          "to": ".",
          "filter": [
            "tray*Template*.png",
            "icon.png"
          ]
        },
        {
          "from": "native/desktop/build/desktop-helper",
          "to": "desktop-helper"
        }
      ],
      "extendInfo": {
        "NSAccessibilityUsageDescription": "LOLPingYourAI uses desktop input for pings and explicitly requested teammate actions.",
        "NSScreenCaptureUsageDescription": "LOLPingYourAI captures the region you ping for your chosen AI teammate."
      }
    },
    "dmg": {
      "artifactName": "LOLPingYourAI-${version}-arm64.dmg"
    },
    "npmRebuild": false,
    "asar": false
  },
  "bin": {
    "lolpingai": "ai/cli.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.0",
    "sharp": "^0.34.0"
  }
}
